{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Feedback",
  "version": "3.3.2",
  "identifier": "com.senaka.feedback",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Feedback Manager v3.3.2",
        "width": 1800,
        "height": 1100,
        "minWidth": 1400,
        "minHeight": 900,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
