{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/project-fallback.ts",
    ".opencode/plugins/credit-fallback.ts"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "semble": {
      "type": "local",
      "command": ["uvx", "--from", "semble[mcp]", "semble"],
      "enabled": true
    },
    "websearch": {
      "type": "local",
      "command": ["npx", "-y", "@zhafron/mcp-web-search"],
      "enabled": true
    }
  },
  "lsp": true,
  "permission": {
    "lsp": "allow"
  }
}