{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "opencode",
  "leader_timeout": 2000,
  "keybinds": {
    "leader": "ctrl+x",
    "command_list": "ctrl+p"
  },
  "mouse": true,
  "scroll_acceleration": {
    "enabled": false
  },
  "scroll_speed": 3,
  "diff_style": "auto",
  "attention": {
    "enabled": false,
    "notifications": true,
    "sound": false,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  }
}
